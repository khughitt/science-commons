from __future__ import annotations

import os
import sys
from pathlib import Path


DATASET_NAME = "variant-labels-dbsnp-human"
ARCHIVES = (
    "GCF_000001405.40.gz",
    "GCF_000001405.25.gz",
)
ARCHIVE_URLS = {
    "GCF_000001405.40.gz": "https://ftp.ncbi.nih.gov/snp/archive/b157/VCF/GCF_000001405.40.gz",
    "GCF_000001405.25.gz": "https://ftp.ncbi.nih.gov/snp/archive/b157/VCF/GCF_000001405.25.gz",
}


def _path_config(name: str, default: Path | str) -> Path:
    value = config.get(name)
    if value is None:
        value = default
    return Path(str(value)).expanduser()


def _required_path_config(name: str) -> Path:
    value = config.get(name)
    if value is None:
        raise ValueError(f"{name} config is required; run through science commons dataset build")
    return Path(str(value)).expanduser()


RECIPE_DIR = Path(workflow.basedir)
DATASET_DIR = RECIPE_DIR.parent
COMMONS_DATA_ROOT = _path_config(
    "commons_data_root",
    os.environ.get("SCIENCE_COMMONS_DATA_ROOT", "/data/science-commons"),
)
DATASET_OUTPUT_DIR = _required_path_config("dataset_output_dir")
SOURCE_ROOT = _path_config("source_root", DATASET_OUTPUT_DIR / "_src")
OUTPUT_ROOT = _path_config("output_root", COMMONS_DATA_ROOT)
ASSEMBLY_REGISTRY = _path_config(
    "assembly_registry",
    COMMONS_DATA_ROOT / "assembly-registry" / "assemblies.csv",
)
PYTHON = str(config.get("python", sys.executable))

SOURCE_ARCHIVES = tuple(str(SOURCE_ROOT / name) for name in ARCHIVES)
SOURCE_MD5S = tuple(str(SOURCE_ROOT / f"{name}.md5") for name in ARCHIVES)
LOCKFILE = str(RECIPE_DIR / "lockfile.yaml")
DATAPACKAGE = str(DATASET_DIR / "datapackage.yaml")
SQLITE = str(DATASET_OUTPUT_DIR / "rsid_mappings.sqlite")
SUMMARY = str(DATASET_OUTPUT_DIR / "build-summary.yaml")


rule all:
    input:
        SQLITE,
        SUMMARY,
        DATAPACKAGE,


rule fetch_archive:
    output:
        archive=str(SOURCE_ROOT / "{archive}"),
        md5=str(SOURCE_ROOT / "{archive}.md5"),
    params:
        fetch_py=str(RECIPE_DIR / "fetch.py"),
        source_root=str(SOURCE_ROOT),
        url=lambda wildcards: ARCHIVE_URLS[wildcards.archive],
    shell:
        "{PYTHON:q} {params.fetch_py:q} "
        "--url {params.url:q} "
        "--download-only "
        "--output-dir {params.source_root:q} "
        "--lockfile {LOCKFILE:q}"


rule write_lockfile:
    input:
        archives=SOURCE_ARCHIVES,
        md5s=SOURCE_MD5S,
    output:
        lockfile=LOCKFILE,
    params:
        fetch_py=str(RECIPE_DIR / "fetch.py"),
        source_root=str(SOURCE_ROOT),
    shell:
        "{PYTHON:q} {params.fetch_py:q} "
        "--refresh-lockfile "
        "--require-existing "
        "--output-dir {params.source_root:q} "
        "--lockfile {output.lockfile:q}"


wildcard_constraints:
    archive="GCF_000001405\\.(40|25)\\.gz"


rule build_dataset:
    input:
        lockfile=LOCKFILE,
        archives=SOURCE_ARCHIVES,
        md5s=SOURCE_MD5S,
        assembly_registry=str(ASSEMBLY_REGISTRY),
    output:
        sqlite=SQLITE,
        summary=SUMMARY,
        datapackage=DATAPACKAGE,
    params:
        build_py=str(RECIPE_DIR / "build.py"),
        source_root=str(SOURCE_ROOT),
        output_root=str(OUTPUT_ROOT),
        dataset_output_dir=str(DATASET_OUTPUT_DIR),
    shell:
        "{PYTHON:q} {params.build_py:q} "
        "--input-root {params.source_root:q} "
        "--output-root {params.output_root:q} "
        "--dataset-output-dir {params.dataset_output_dir:q} "
        "--lockfile {input.lockfile:q} "
        "--assembly-registry {input.assembly_registry:q} "
        "--datapackage {output.datapackage:q} "
        "--update-datapackage"
